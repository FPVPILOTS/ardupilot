# Dedicated one-battery SRXL2 startup experiment: NOT flight firmware.
# Keeps native ArmedBench FC0/ESC0 handshake, special MAIN3-inhibited IO,
# UART4 AUX7 PA0 open-drain with weak pull-up, and 115200 baud at startup.
# NEVER ARM this target; actual motor phases must be disconnected/insulated.
include ../Pixhawk6C-SpktSmart-ArmedBench-IOInstall/hwdef.dat
define CHIBIOS_SHORT_BOARD_NAME "Pix6C-SPKT-EarlyNative"
define AP_SPEKTRUM_SMART_ESC_NATIVE_EARLY_BOOT 1
