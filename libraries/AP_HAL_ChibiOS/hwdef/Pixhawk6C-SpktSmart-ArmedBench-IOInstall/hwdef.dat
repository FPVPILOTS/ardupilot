# EXPLICIT, NON-FLIGHT Avian SRXL2 armed bench commissioning image.
# NOT the ordinary Pixhawk6C, production or TurnLab target.
# COMPILE-ONLY candidate for future NORMAL ArduPlane arming.
# Does NOT currently enable motor TX: the production profile stays unqualified.
# No automatic arming; no MAIN3 PWM fallback; RC/ESC/UART faults latch.
# Proposed 0..6% control vector is source-level ONLY: actual ESC motor
# power/RPM at those wire values has NOT been physically qualified.
# CH7/reverse is unqualified and is deliberately NOT transmitted.
# Never flash this target expecting a ready-to-arm motor controller.
include ../Pixhawk6C-SpktSmart/hwdef.dat
define CHIBIOS_SHORT_BOARD_NAME "Pix6C-SPKT-ArmedBench"
define AP_SPEKTRUM_SMART_ESC_ARMED_BENCH_EXPERIMENTAL 1

# This opt-in image retains the special MAIN3-inhibited IOMCU companion.
# Flashing the .apj may update the IOMCU. NEVER use stock IO firmware here.
ROMFS io_firmware.bin build/iomcu-f103-spktsmart/bin/iofirmware_lowpolh.bin
ROMFS io_firmware_dshot.bin build/iomcu-f103-spktsmart/bin/iofirmware_lowpolh.bin
define AP_IOMCU_FIRMWARE_UPDATE_ENABLED 1
